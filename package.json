{
	"name": "x402-stock-jokes",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"dev:worker": "vite dev",
		"dev:web": "cd web && astro dev",
		"build": "vite build && bun run build:web",
		"build:web": "cd web && astro build",
		"preview": "vite preview",
		"deploy": "bun run build && wrangler deploy",
		"check:types": "tsc --noEmit && tsc --noEmit -p web",
		"check": "bun run check:types && bun test",
		"wallet:new": "bun scripts/wallet-new.ts",
		"approve": "bun scripts/approve-permit2.ts",
		"doctor": "bun scripts/doctor.ts",
		"test": "bun test",
		"db:migrate": "wrangler d1 migrations apply x402-stock-jokes --remote",
		"db:migrate:local": "wrangler d1 migrations apply x402-stock-jokes --local",
		"types": "wrangler types"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^1.3.0",
		"@flue/runtime": "^2.3.0",
		"@x402/core": "^2.28.0",
		"@x402/evm": "^2.28.0",
		"@x402/fetch": "^2.28.0",
		"hono": "^4.12.32",
		"jose": "^6.2.12",
		"valibot": "^1.5.0",
		"viem": "^2.57.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.39.2",
		"@flue/cli": "^2.3.0",
		"@flue/vite": "^2.3.0",
		"@types/node": "^22.10.10",
		"astro": "^7.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.0.14",
		"wrangler": "^4.113.0"
	}
}
