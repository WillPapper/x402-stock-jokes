{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "x402-stock-jokes",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	// Workers Traces shows each agent response as a trace with agent-level
	// spans: https://flueframework.com/docs/guide/observability/#cloudflare
	"observability": { "traces": { "enabled": true } },
	// Keyless `cloudflare/...` models run through this Workers AI binding and
	// go through AI Gateway by default. It reaches your Cloudflare account even
	// in local dev (`npx wrangler login` first):
	// https://flueframework.com/docs/guide/models/#cloudflare-workers-ai-cloudflare-only
	"ai": { "binding": "AI" },
	// Every agent generates a Durable Object class named after its identity
	// (StockJoke -> FlueStockJokeAgent), and Cloudflare requires a migration
	// entry for each one. Append a new tag when you add an agent:
	// https://flueframework.com/docs/guide/cloudflare-target/#managing-migrations
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["FlueStockJokeAgent"] }]
}
