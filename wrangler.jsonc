{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "x402-stock-jokes",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	// Workers Traces shows each agent response as a trace with agent-level
	// spans: https://flueframework.com/docs/guide/observability/#cloudflare
	"observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true }, "traces": { "enabled": true } },
	// Non-secret knobs. Secrets (account id, API token, wallet key) live in
	// .dev.vars locally and `wrangler secret put` in production.
	"vars": {
		"ORCHESTRATOR_MODEL": "alibaba/qwen3.8-27b",
		"JOKE_MODEL": "google/gemma-4-26b-a4b-it",
		"MAX_USDC_PER_DATA_CALL": "0.01",
		"MAX_USDC_PER_INFERENCE": "0.25",
		"MAX_USDC_PER_ISOLATE": "5",
		// Alchemy fallback (src/lib/alchemy.ts): when the free-plan key is out of
		// capacity, calls go to Alchemy's x402 gateway on the wallet's credits.
		// "off": never pay, use only credits already on the wallet (since
		// 2026-10-17: a $1 top-up was not credited, docs/alchemy-gateway-topup-not-credited.md).
		// "credits": also buy $1 top-ups (at most one a day app-wide). Pay-per-request is never paid.
		"ALCHEMY_GATEWAY_PAYMENTS": "off",
		"MAX_USDC_PER_ALCHEMY_TOPUP": "1",
		"MAX_USDC_ALCHEMY_PER_ISOLATE": "1",
		"RUNNER_LOCATION_HINT": "wnam",
		// /api/events and /api/_trace sit behind a Cloudflare Access self-hosted app;
		// the Worker verifies the Access JWT against this team domain and AUD tag.
		// Empty AUD = those routes answer 403 (fail closed). See README "Logging".
		"ACCESS_TEAM_DOMAIN": "https://papper.cloudflareaccess.com",
		"ACCESS_AUD": "e2997b9c7d9e7508129c7b29211b0db522890fc9f1e805d926644caa3ad5e217"
	},
	// public/ is served as static assets (the page); agent and API routes run
	// on the Worker first.
	"assets": { "directory": "./dist/client", "run_worker_first": ["/agents/*", "/api/*"] },
	// Every agent generates a Durable Object class named after its identity
	// (StockJoke -> FlueStockJokeAgent), and Cloudflare requires a migration
	// entry for each one. Append a new tag when you add an agent:
	// https://flueframework.com/docs/guide/cloudflare-target/#managing-migrations
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["FlueStockJokeAgent"] },
		{ "tag": "v2", "renamed_classes": [{ "from": "FlueStockJokeAgent", "to": "FlueJokeAgent" }] },
		{ "tag": "v3", "new_sqlite_classes": ["JokeRunner"] }
	],
	// JokeRunner (src/cloudflare.ts) starts every conversation from a US-pinned
	// Durable Object so AI Gateway machine payments (US-only) see a US "visitor".
	"durable_objects": { "bindings": [{ "name": "JOKE_RUNNER", "class_name": "JokeRunner" }] },
	// The page's feed and per-ticker cache. Apply migrations/ with
	// `bunx wrangler d1 migrations apply x402-stock-jokes --remote` (and --local for dev).
	"d1_databases": [{ "binding": "DB", "database_name": "x402-stock-jokes", "database_id": "79517cc1-da36-41eb-a82b-da3b9116a939", "migrations_dir": "migrations" }],
	// Public hostname, fronted by Cloudflare's Monetization Gateway (seller rule
	// charges 0.10 USDC for POST /agents/joke/* without the password header).
	"routes": [{ "pattern": "jokes.papper.me", "custom_domain": true }]
}
